<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>28</Size>
    <Spacing>2</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <!-- Латинские буквы (A-Z, a-z) -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Русские буквы (А-Я, а-я) -->
      <CharacterRegion>
        <Start>&#1040;</Start>
        <End>&#1103;</End>
      </CharacterRegion>
      <!-- Дополнительные русские символы (Ё, ё) -->
      <CharacterRegion>
        <Start>&#1025;</Start>
        <End>&#1105;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>